{
  "name": "frank-enendu-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "node --test scripts/verify-build.mjs",
    "build:github": "PORTFOLIO_TARGET=github astro build",
    "check:github": "PORTFOLIO_TARGET=github node --test scripts/verify-build.mjs",
    "build:all": "npm run build && npm run check && npm run build:github && npm run check:github",
    "deploy:cloudflare": "npm run build && npm run check && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.8",
    "astro": "7.3.4"
  },
  "devDependencies": {
    "wrangler": "4.137.0"
  }
}
