---
import { site } from '../lib/site';
---
<section class="diary-login" data-diary-login aria-labelledby="diary-login-title">
  <span class="eyebrow">Your invitation</span>
  <h2 id="diary-login-title">Come inside.</h2>
  <p>Use the email address I invited. I’ll send a one-time code to your inbox.</p>
  <form data-request-code>
    <label for="diary-email">Email address</label>
    <input id="diary-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" maxlength="254" required />
    <button class="button button-primary" type="submit">Send my sign-in code <span aria-hidden="true">→</span></button>
  </form>
  <form data-verify-code hidden>
    <label for="diary-code">Your eight-digit code</label>
    <input id="diary-code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{8}" minlength="8" maxlength="8" placeholder="00000000" required />
    <p class="form-help">Use the code in the browser where you requested it. It expires after ten minutes.</p>
    <button class="button button-primary" type="submit">Open the diary <span aria-hidden="true">→</span></button>
    <button class="diary-text-button" type="button" data-change-email>Use another email or request a new code</button>
  </form>
  <p class="diary-message" data-login-message role="status" aria-live="polite"></p>
  <div class="diary-login-foot"><p>Haven’t got an invitation?</p><a class="text-link" href={`mailto:${site.email}?subject=Access%20to%20Inside%20the%20Work`}>Ask me for access <span aria-hidden="true">↗</span></a></div>
</section>
