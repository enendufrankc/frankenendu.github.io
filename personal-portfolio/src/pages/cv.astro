---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../content/profile.json';
import { site, path } from '../lib/site';
const date=(value:string|null)=>!value?'Present':/^\d{4}$/.test(value)?value:new Date(value+'-01').toLocaleDateString('en-GB',{month:'short',year:'numeric',timeZone:'UTC'});
---
<BaseLayout title="Frank Enendu — CV" description="AI engineering, embedded technical consulting and product development. Frank Enendu’s professional experience and education.">
  <div class="shell"><div class="cv-toolbar"><p>A concise, print-friendly CV.<br />Use your browser’s “Save as PDF” option.</p><button class="button button-primary" type="button" id="print-cv">Print / Save PDF <span aria-hidden="true">↗</span></button></div><article class="cv-paper"><header><h1>{profile.name}</h1><p class="cv-title">AI engineer · Technical consultant · Product builder</p><div class="cv-contact"><span>{profile.location}</span><a href={`mailto:${site.email}`}>{site.email}</a><a href={site.linkedin}>LinkedIn</a><a href={Astro.site.href}>Portfolio</a></div><p class="cv-summary">{profile.summary}</p></header>
  <section><h2>Experience</h2>{profile.experience.slice(0,7).map(role=><div class="cv-role"><div class="cv-role-head"><h3>{role.company}</h3><span>{date(role.start)} — {date(role.end)}</span></div><p class="position">{role.title}</p><p>{role.description}</p></div>)}<p class="cv-earlier">Earlier roles in analytics and operations: <a href={path('about/')}>view the full career timeline</a>.</p></section>
  <section><h2>Selected independent work</h2><div class="cv-projects"><div><h3>FairLens · OgaHQ · Verify</h3><p>Personal startups spanning evidence-led application review, merchant operations and product verification.</p></div><div><h3>SafeAI</h3><p>Python SDK for runtime policy controls, data redaction, tool contracts, approvals and audit records. Apache-licensed; public beta package.</p></div><div><h3>AiGen</h3><p>Developing a Python control plane for coding-agent telemetry, repository memory, handoffs and MCP access.</p></div><div><h3>CaseReviewer</h3><p>Initial pre-launch technical cofounder; built the AI engine for the early product.</p></div></div></section>
  <section><h2>Education</h2>{profile.education.slice(0,1).map(e=><div class="cv-role"><div class="cv-role-head"><h3>{e.institution}</h3><span>{e.period}</span></div><p class="position">{e.qualification}</p><p>{e.description}</p></div>)}{profile.education.filter(e=>e.institution.includes('Owerri')).map(e=><div class="cv-role"><div class="cv-role-head"><h3>{e.institution}</h3><span>{e.period}</span></div><p>{e.qualification}</p></div>)}</section>
  <section><h2>Engineering skills</h2><div class="cv-skills">{profile.skills.map(s=><p><strong>{s.label}:</strong> {s.items.join(' · ')}</p>)}</div></section></article></div>
  <script>document.querySelector('#print-cv')?.addEventListener('click',()=>window.print());</script>
</BaseLayout>
