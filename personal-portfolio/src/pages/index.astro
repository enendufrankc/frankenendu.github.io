---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { path, site } from '../lib/site';
import writing from '../content/writing.json';
const projects = (await getCollection('projects')).sort((a,b) => a.data.order - b.data.order);
const category = (name: string) => projects.filter(p=>p.data.category === name);
const clients = category('client'); const ballys = category('ballys');
---
<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow"><span class="live-dot"></span> AI engineer & product builder · Manchester, UK</p>
      <h1>AI engineering.<br /><em>From the problem<br />to the product.</em></h1>
      <p class="hero-description">I work with people to understand their workflows, build the systems they need, and put AI to use in the real world.</p>
      <div class="hero-actions"><a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">↘</span></a><a class="text-link" href={path('cv/')}>View my CV <span aria-hidden="true">↗</span></a></div>
    </div>
    <aside class="hero-aside">
      <figure class="hero-portrait">
        <div class="portrait-image"><img src={path('images/frank-enendu.png')} alt="Portrait of Frank Enendu" width="495" height="504" fetchpriority="high" /></div>
        <figcaption><span>Frank Enendu</span><span class="portrait-caption">Engineer &amp; builder</span></figcaption>
      </figure>
      <div class="current-role"><span class="eyebrow">Currently</span><p>AI Engineer R&D <span>at Bally’s Interactive</span></p><a href="#ballys">Inside the work <span aria-hidden="true">↗</span></a></div>
    </aside>
    <div class="hero-foot"><span>Applied AI</span><span>Agent systems</span><span>Technical consulting</span><span>Product engineering</span><a href="#work" aria-label="Scroll to selected work">Scroll to explore ↓</a></div>
  </section>

  <section class="section shell" id="work">
    <SectionHeading number="01" label="Selected client work" title="Built alongside the people using it." description="At BCN, I worked across pre-sales, consulting and R&D, embedded with client businesses to turn operational needs into working AI solutions." />
    <div class="work-grid">{clients.filter(p=>p.data.detail).map(project=><ProjectCard project={project} />)}</div>
    <div class="additional-work"><p class="eyebrow">More client engagements</p><div class="small-work-grid">{clients.filter(p=>!p.data.detail).map(p=><article><h3>{p.data.title}</h3><p>{p.data.summary}</p><span class="small-stage">{p.data.stage}</span></article>)}</div></div>
  </section>

  <section class="ballys-section" id="ballys"><div class="shell section">
    <SectionHeading number="02" label="Bally’s · AI R&D" title="The engineering behind the intelligence." description="My current work spans multimodal pipelines, conversational research and tools that help engineering teams work with agents." />
    <div class="ballys-grid"><aside class="ballys-note"><span class="eyebrow">A working practice</span><h3>Useful systems need<br /><em>more than a model.</em></h3><p>Capture, context, quality checks, interfaces and infrastructure. I work across the pieces that make an AI system usable.</p><div class="principle-list"><span>Evidence before confidence</span><span>Explicit control over actions</span><span>Feedback built into the workflow</span></div></aside><div class="engineering-list">{ballys.filter(p=>p.data.detail).map(project=><ProjectCard project={project} variant="list" />)}</div></div>
    <div class="supporting-work">{ballys.filter(p=>!p.data.detail).map(p=><article><span class="small-stage">{p.data.stage}</span><h3>{p.data.title}</h3><p>{p.data.summary}</p></article>)}</div>
  </div></section>

  <section class="section shell" id="ventures">
    <SectionHeading number="03" label="Ventures I’m building" title="My own problems worth solving." description="Alongside my engineering work, I’m building products for selection teams, everyday merchants and people who need to trust what they buy." />
    <div class="venture-grid">{category('venture').map((p,i)=><article class:list={['venture-card', `venture-${p.id}`]}><div class="venture-visual"><span class="venture-symbol" aria-hidden="true">{['◈','↗','✓'][i]}</span><h3>{p.data.title}<span>.</span></h3><span class="venture-caption">{['OPPORTUNITY, WITH EVIDENCE','THE EVERYDAY BUSINESS OS','TRUST, AT THE ITEM LEVEL'][i]}</span></div><div class="venture-body"><span class="eyebrow">Personal startup</span><p>{p.data.summary}</p><a class="text-link" href={p.data.url} target="_blank" rel="noopener noreferrer">Explore {p.data.title} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div></article>)}</div>
  </section>

  <section class="section shell tooling-section" id="open-source">
    <SectionHeading number="04" label="Agent tooling" title="Tools for the way we build now." description="Two personal projects exploring how to observe coding agents, preserve context and put practical controls around their actions." />
    <div class="tools-grid">{category('tool').map(project=><ProjectCard project={project} variant="tool" />)}</div>
    <p class="section-footnote">SafeAI is available as a Python package. AiGen’s current control-plane implementation is in development.</p>
  </section>

  <section class="section shell further-section" id="further-work">
    <SectionHeading number="05" label="Further work" title="Different contexts. Hands-on contribution." />
    <div class="further-grid">{category('other').map(p=><article><span class="eyebrow">{p.data.stage}</span><h3>{p.data.title}</h3><p>{p.data.summary}</p><p class="role-note">{p.data.role}</p>{p.data.url && <a class="text-link" href={p.data.url} target="_blank" rel="noopener noreferrer">Visit project <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>}</article>)}</div>
  </section>

  <section class="section shell writing-section" id="writing">
    <SectionHeading number="06" label="Writing & learning" title="Working things out. Sharing what I learn." />
    <div class="writing-list">{writing.map((article,i)=><a href={article.url} target="_blank" rel="noopener noreferrer"><span class="writing-index">0{i+1}</span><div><span class="eyebrow">{article.topic}</span><h3>{article.title}</h3><p>{article.description}</p></div><span class="writing-arrow" aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>)}</div>
  </section>

  <section class="background-section"><div class="shell background-inner"><div><span class="eyebrow">The foundations</span><h2>Curiosity, backed<br />by the fundamentals.</h2><p>MSc Data Science and Artificial Intelligence, with Distinction, from the University of Liverpool. A career spanning data science, embedded AI consulting and product engineering.</p><a class="text-link" href={path('about/')}>More about me <span aria-hidden="true">↗</span></a></div><div class="short-timeline"><div><span>2026 — now</span><p>Bally’s Interactive<small>AI Engineer R&D</small></p></div><div><span>2023 — 2026</span><p>BCN<small>Graduate Engineer → AI Engineer</small></p></div><div><span>2021 — 2022</span><p>Hubpay<small>Junior Data Scientist</small></p></div></div></div></section>

  <section class="contact-section shell" id="contact"><p class="eyebrow">Let’s talk</p><div class="contact-row"><h2>Have a good problem<br /><em>to work on?</em></h2><div><p>I’m always interested in thoughtful teams, useful products and the engineering that connects them.</p><a class="contact-email" href={`mailto:${site.email}`}>Say hello <span aria-hidden="true">↗</span></a><div class="social-links"><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://inflecthub.com/" target="_blank" rel="noopener noreferrer">Inflect Hub ↗</a></div></div></div></section>
</BaseLayout>
