---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DiaryLogin from '../../../components/DiaryLogin.astro';
import { base, diaryPath } from '../../../lib/site';
---
<BaseLayout title="Project workspace — Inside the Work" description="The private workspace for project notes and build guides." noindex>
  <div class="diary-page shell" data-project-page="admin" data-mirror={String(base !== '/')}>
    <header class="diary-masthead"><a class="text-link" href={`${diaryPath}projects/`}>← Project library</a><a class="text-link" href={`${diaryPath}admin/`}>Monthly writing &amp; readers ↗</a></header>
    <section class="diary-admin-heading"><p class="eyebrow">Your working knowledge</p><h1>Keep the idea.<br /><em>Explain the making.</em></h1><p>One place for each project’s story, evidence and build guide.</p></section>
    <div class="diary-admin-gate" data-public-area><DiaryLogin /></div>
    <section class="diary-session" data-session-bar hidden><p data-session-description></p><button class="diary-text-button" type="button" data-logout>Sign out</button></section>
    <div data-private-area hidden class="project-author-layout">
      <aside class="diary-drafts project-author-list"><div class="diary-section-heading"><h2>Your topics</h2><button class="diary-text-button" type="button" data-new-project>+ New</button></div><label for="author-project-search">Find a project</label><input id="author-project-search" type="search" autocomplete="off" placeholder="Search topics…" /><p class="form-help" data-author-project-count></p><div data-author-project-list></div></aside>
      <div class="diary-editor"><form data-project-editor>
        <div class="diary-editor-heading"><h2 data-project-editor-heading>New project topic</h2><span class="diary-badge" data-project-editor-status>Draft</span></div>
        <label for="project-title">Title</label><input id="project-title" name="title" maxlength="160" required />
        <label for="project-slug">Page address</label><input id="project-slug" name="slug" maxlength="80" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="game-dna" required /><p class="form-help">The last part of /diary/projects/your-topic/. Fixed after the first save.</p>
        <label for="project-summary">Short description</label><textarea id="project-summary" name="summary" rows="3" maxlength="600" required></textarea>
        <div class="diary-field-row"><div><label for="edit-project-area">Area</label><input id="edit-project-area" name="area" maxlength="80" list="project-area-options" required /><datalist id="project-area-options"><option>Programmes</option><option>Game intelligence</option><option>Engineering delivery</option><option>Platforms and tooling</option><option>Learning and community</option><option>Research and adoption</option><option>Operational automation</option></datalist></div><div><label for="edit-project-stage">Current stage</label><input id="edit-project-stage" name="stage" maxlength="120" placeholder="Prototype under evaluation" required /></div></div>
        <label for="project-contributors">Documented contributors <span class="form-optional">(one per line)</span></label><textarea id="project-contributors" name="contributors" rows="2"></textarea>
        <div class="diary-field-row"><div><label for="project-aliases">Other names <span class="form-optional">(one per line)</span></label><textarea id="project-aliases" name="aliases" rows="2"></textarea></div><div><label for="project-evidence-date">Evidence through</label><input id="project-evidence-date" name="evidenceDate" type="date" required /></div></div>
        <label for="project-overview-editor">Project overview <span class="form-optional">(Markdown)</span></label><textarea id="project-overview-editor" class="diary-markdown-input" name="overviewMarkdown" rows="15" maxlength="120000" required spellcheck="true"></textarea><p class="form-help">Core idea, who it helps, current evidence, your contribution and team credit. Publishing makes this overview available to invited readers.</p>
        <label for="project-guide-editor">Build-from-scratch guide <span class="form-optional">(Markdown)</span></label><textarea id="project-guide-editor" class="diary-markdown-input" name="guideMarkdown" rows="22" maxlength="120000" spellcheck="true"></textarea>
        <label for="project-guide-access">Who can read the build guide?</label><select id="project-guide-access" name="guideVisibility"><option value="owner">Only me</option><option value="readers">Invited readers, when the overview is published</option></select><p class="form-help">Keep internal details in the owner-only guide. Choose invited readers only after reviewing the guide for external sharing.</p>
        <details class="diary-public-settings"><summary>Evidence and connections</summary><label for="project-source-notes">Source notes <span class="form-optional">(always owner-only)</span></label><textarea id="project-source-notes" name="sourceNotes" rows="6" maxlength="16000"></textarea><div class="diary-field-row"><div><label for="project-related-select">Related topics</label><select id="project-related-select" name="relatedSlugs" multiple size="7"></select></div><div><label for="project-months-select">Monthly entries</label><select id="project-months-select" name="months" multiple size="7"></select></div></div><p class="form-help">Hold Command (Mac) or Control (Windows) to choose several. Readers only see links to published material they can access.</p></details>
        <div class="diary-editor-actions"><button type="submit" class="button button-primary" data-project-save>Save draft</button><button type="button" class="button button-ghost" data-preview-overview>Preview overview</button><button type="button" class="button button-ghost" data-preview-guide>Preview guide</button><button type="button" class="button button-ghost" data-project-publish>Publish overview</button><button type="button" class="diary-text-button" data-project-unpublish hidden>Unpublish</button></div>
        <p class="diary-message" data-project-editor-message role="status" aria-live="polite"></p><a class="text-link" data-project-read-link hidden>Open reading page ↗</a>
      </form>
      <section class="diary-editor-preview" data-project-preview hidden><div class="diary-section-heading"><h2 data-project-preview-title>Preview</h2><button type="button" class="diary-text-button" data-project-close-preview>Close preview</button></div><div class="diary-prose" data-project-preview-body></div></section></div>
    </div>
    <p class="diary-message" data-page-message role="status" aria-live="polite"></p>
  </div>
  <script>import '../../../lib/diary-project-admin';</script>
</BaseLayout>
