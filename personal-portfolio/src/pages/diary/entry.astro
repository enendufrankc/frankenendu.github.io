---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DiaryLogin from '../../components/DiaryLogin.astro';
import DiaryNavigation from '../../components/DiaryNavigation.astro';
import { diaryPath, base } from '../../lib/site';
---
<BaseLayout title="Read Inside the Work — Frank Enendu" description="A monthly entry from Frank Enendu’s private R&D diary. Sign in with your invitation to read." noindex>
  <div class="diary-page diary-entry-page shell" data-diary-page="entry" data-mirror={String(base !== '/')}>
    <header class="diary-masthead"><a class="text-link" href={diaryPath}>← All monthly notes</a><span class="diary-edition">Inside the Work / Frank Enendu</span></header>
    <DiaryNavigation active="notes" />
    <section class="diary-session" data-session-bar hidden><p data-session-description></p><button class="diary-text-button" type="button" data-logout>Sign out</button></section>
    <div class="diary-entry-gate" data-public-area><div><p class="eyebrow">Inside the Work</p><h1>A closer look<br /><em>at the work.</em></h1><p>This entry is shared with invited readers. Sign in to continue.</p></div><DiaryLogin /></div>
    <article class="diary-article" data-private-area hidden>
      <header class="diary-article-header"><p class="eyebrow" data-entry-month></p><h1 data-entry-title></h1><p class="diary-article-summary" data-entry-summary></p><div class="diary-article-meta"><span>By Frank Enendu</span><span data-entry-reading></span><span data-entry-updated></span></div><div class="diary-tags" data-entry-tags></div></header>
      <div class="diary-prose" data-entry-body></div>
      <section class="project-entry-topics" data-entry-projects-section hidden><h2>Explore the projects.</h2><div class="project-related-list" data-entry-projects></div></section>
      <section class="diary-attachments" data-attachments-area hidden><h2>Alongside the notes.</h2><p>Supporting material shared with the same access window.</p><ul data-attachments-list></ul></section>
      <nav class="diary-neighbours" data-entry-neighbours aria-label="Other monthly entries"></nav>
    </article>
    <p class="diary-message" data-page-message role="status" aria-live="polite"></p>
  </div>
  <script>import '../../lib/diary-reader';</script>
</BaseLayout>
