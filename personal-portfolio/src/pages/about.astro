---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import profile from '../content/profile.json';
import { path, site } from '../lib/site';
const date=(value:string|null)=>!value?'Present':/^\d{4}$/.test(value)?value:new Date(value+'-01').toLocaleDateString('en-GB',{month:'short',year:'numeric',timeZone:'UTC'});
---
<BaseLayout title="About Frank Enendu — AI Engineer & Builder" description="My background in data science, embedded client consulting, AI engineering and independent product development.">
  <div class="shell"><header class="page-intro"><p class="eyebrow">A little about me</p><h1>Curious about the problem.<br /><em>Committed to the work.</em></h1><p class="lede">I'm Frank, an AI engineer based in Manchester. I build systems with the people who will use them, and products around problems I care about.</p></header><div class="about-body"><div class="prose"><p>My career has taken me from business intelligence and data science into client-facing AI engineering, agent systems and product development. The thread through that work is understanding a real workflow, then building something useful within its constraints.</p><p>At Bally’s Interactive, I work in AI R&D on multimodal pipelines, conversational research and developer enablement. Before that, I worked at BCN across pre-sales, consulting and R&D, embedded with client businesses to design and build AI solutions.</p><p>Outside work, I'm building <a href="https://www.fairlens.app/">FairLens</a>, <a href="https://ogahq.app/">OgaHQ</a> and <a href="https://verifyproduct.app/">Verify</a>. My developer-tooling projects, SafeAI and AiGen, explore controls, visibility and continuity for AI agents.</p><p>My consulting work has its own home at <a href="https://inflecthub.com/">Inflect Hub</a>. This site brings together my broader engineering work, learning and independent projects.</p></div><aside class="about-panel"><span class="eyebrow">A foundation in data & AI</span><h2>MSc, with Distinction.</h2><p>Data Science and Artificial Intelligence<br /><strong>University of Liverpool</strong><br />2022–2023</p><p class="about-modules">Applied AI, machine learning, data mining, computational intelligence, and the mathematics behind them.</p><a class="text-link" href={path('cv/')}>View my CV ↗</a></aside></div>
  <SectionHeading number="01" label="Experience" title="The path so far." /><div class="timeline">{profile.experience.map(role=><article class="timeline-entry"><div class="timeline-date">{date(role.start)} — {date(role.end)}</div><div><h3>{role.company}</h3><p class="position">{role.title}</p>{role.description && <p class="description">{role.description}</p>}</div></article>)}</div>
  <section class="section"><SectionHeading number="02" label="Education & learning" title="Strong foundations. Continued curiosity." /><div class="education-grid">{profile.education.map(e=><article>{e.period && <span class="eyebrow">{e.period}</span>}<h3>{e.institution}</h3><p><strong>{e.qualification}</strong></p><p>{e.description}</p></article>)}</div></section>
  <section class="section tooling-section"><SectionHeading number="03" label="Engineering practice" title="What I work with." /><div class="skill-grid">{profile.skills.map(skill=><div><h3>{skill.label}</h3><ul>{skill.items.map(item=><li>{item}</li>)}</ul></div>)}</div></section>
  <div class="related-section"><p class="eyebrow">Keep the conversation going</p><div class="related-links"><a href={`mailto:${site.email}`}>Email me ↗</a><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={path('#work')}>Explore the work ↗</a></div></div></div>
</BaseLayout>
