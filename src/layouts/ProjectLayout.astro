---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  domain: string;
  tech: string[];
  github: string | null;
  demo: string | null;
  article: string | null;
  image: string;
  status: "public" | "private" | "client-work";
}

const { title, description, domain, tech, github, demo, article, image, status } =
  Astro.props;
---

<BaseLayout title={title} description={description} image={image} type="article">
  <header class="project-header container">
    <a href="/work" class="back-link">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M19 12H5M12 5l-7 7 7 7" />
      </svg>
      Back to Projects
    </a>

    <div class="project-header__meta">
      <span class="tag">{domain}</span>
      {status === "public" && <span class="tag tag--accent">Open Source</span>}
    </div>

    <h1 class="project-header__title">{title}</h1>
    <p class="project-header__description">{description}</p>

    {
      (github || demo || article) && (
        <div class="project-header__links">
          {github && (
            <a href={github} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              GitHub
            </a>
          )}
          {demo && (
            <a href={demo} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6" />
                <polyline points="15 3 21 3 21 9" />
                <line x1="10" y1="14" x2="21" y2="3" />
              </svg>
              Live Demo
            </a>
          )}
          {article && (
            <a href={article} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                <polyline points="14 2 14 8 20 8" />
                <line x1="16" y1="13" x2="8" y2="13" />
                <line x1="16" y1="17" x2="8" y2="17" />
                <polyline points="10 9 9 9 8 9" />
              </svg>
              Article
            </a>
          )}
        </div>
      )
    }

    <div class="project-header__tech">
      {tech.map((t) => <span class="tag">{t}</span>)}
    </div>
  </header>

  <div class="prose container">
    <slot />
  </div>
</BaseLayout>

<style>
  .project-header {
    padding-top: calc(var(--nav-height) + var(--space-xl));
    padding-bottom: var(--space-xl);
    max-width: 860px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    margin-bottom: var(--space-lg);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--accent);
  }

  .project-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .tag--accent {
    background-color: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
  }

  .project-header__title {
    margin-bottom: var(--space-md);
  }

  .project-header__description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 65ch;
    margin-bottom: var(--space-lg);
  }

  .project-header__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .project-header__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .prose {
    max-width: 860px;
    padding-bottom: var(--space-2xl);
  }

  .prose :global(h2) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .prose :global(h3) {
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .prose :global(p) {
    margin-bottom: var(--space-md);
    max-width: 75ch;
    color: var(--text-secondary);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-lg);
    color: var(--text-secondary);
    margin-bottom: var(--space-md);
  }

  .prose :global(li) {
    margin-bottom: var(--space-xs);
  }

  .prose :global(strong) {
    color: var(--text-primary);
  }

  .prose :global(code) {
    background-color: var(--bg-tertiary);
    border-radius: 4px;
    padding: 0.125rem 0.375rem;
  }

  .prose :global(pre) {
    padding: var(--space-lg);
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: var(--space-md);
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    border-radius: 0;
  }
</style>
