---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
}

const { title, description, pubDate, tags } = Astro.props;

const formattedDate = new Intl.DateTimeFormat("en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(pubDate);
---

<BaseLayout title={title} description={description} type="article">
  <article class="blog-post section container">
    <header class="blog-post__header">
      <a href="/blog" class="blog-post__back link">← Back to Blog</a>
      <time
        datetime={pubDate.toISOString()}
        class="blog-post__date"
      >
        {formattedDate}
      </time>
      <h1 class="blog-post__title">{title}</h1>
      {
        tags.length > 0 && (
          <div class="blog-post__tags">
            {tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post__header {
    padding-top: var(--nav-height);
    margin-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .blog-post__back {
    font-size: 0.875rem;
    color: var(--accent);
    transition: color var(--transition-fast);
    margin-bottom: var(--space-sm);
  }

  .blog-post__back:hover {
    color: var(--accent-hover);
  }

  .blog-post__date {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .blog-post__title {
    margin-top: var(--space-xs);
  }

  .blog-post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }

  /* Prose styles for markdown content */
  .prose {
    max-width: 70ch;
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }

  .prose :global(p) {
    margin-bottom: var(--space-md);
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: none;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-lg);
    margin-bottom: var(--space-md);
    color: var(--text-secondary);
  }

  .prose :global(li) {
    margin-bottom: var(--space-xs);
    line-height: 1.75;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    transition: color var(--transition-fast);
  }

  .prose :global(a:hover) {
    color: var(--accent-hover);
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-lg);
    margin: var(--space-lg) 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .prose :global(pre) {
    background-color: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: var(--space-lg);
    overflow-x: auto;
    margin-bottom: var(--space-lg);
  }

  .prose :global(code) {
    font-family: var(--font-code);
    font-size: 0.875em;
  }

  .prose :global(pre code) {
    font-size: 0.875rem;
    color: var(--text-primary);
  }

  .prose :global(:not(pre) > code) {
    background-color: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.125rem 0.375rem;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: var(--space-xl) 0;
  }

  .prose :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }
</style>
