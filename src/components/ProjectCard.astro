---
interface Props {
  title: string;
  description: string;
  domain: string;
  tech: string[];
  image: string;
  slug: string;
  tier: "flagship" | "supporting" | "breadth";
  status: "public" | "private" | "client-work";
}

const { title, description, domain, tech, image, slug, tier, status } =
  Astro.props;
---

<a
  href={`/work/${slug}`}
  class="project-card card"
  data-domain={domain}
>
  <div class="project-card__image">
    <img src={image} alt={title} loading="lazy" />
  </div>
  <div class="project-card__body">
    <div class="project-card__meta">
      <span class="tag">{domain}</span>
      {
        status === "public" && (
          <span class="tag tag--accent">Open Source</span>
        )
      }
    </div>
    <h3 class="project-card__title">{title}</h3>
    <p class="project-card__description">{description}</p>
    <div class="project-card__tech">
      {tech.slice(0, 4).map((t) => <span class="project-card__pill">{t}</span>)}
    </div>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
    text-decoration: none;
  }

  .project-card__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--bg-tertiary);
  }

  .project-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .project-card:hover .project-card__image img {
    transform: scale(1.05);
  }

  .project-card__body {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 1;
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
  }

  .tag--accent {
    background-color: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
  }

  .project-card__title {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    margin-top: var(--space-xs);
  }

  .project-card__description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    max-width: 100%;
  }

  .project-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }

  .project-card__pill {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background-color: var(--bg-tertiary);
    color: var(--text-muted);
  }
</style>
